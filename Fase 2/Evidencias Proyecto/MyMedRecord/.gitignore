# ==========================================
# MyMedRecord - Root .gitignore (Security & Cleanliness)
# ==========================================

# 1. Secretos y Variables de Entorno (CRÍTICO para Repositorios)
.env
.env.local
.env.*.local
*.env
!*.env.example

# 2. Dependencias de Node.js
**/node_modules/
node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 3. Entornos y compilados de Python (ai-service)
**/__pycache__/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
**/venv/
**/.venv/
venv/
.venv/
env/
ENV/

# 4. Archivos temporales de compilación y dist (Frontend)
**/dist/
**/build/
.dist/
.output/

# 5. Archivos del Sistema y Editores de Código
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 6. Archivos subidos o temporales de usuarios
**/uploads/
**/temp/
*.log
