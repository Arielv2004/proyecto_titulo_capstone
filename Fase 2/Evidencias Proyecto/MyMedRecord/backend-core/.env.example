PORT=5000
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=mymedrecord

# Seguridad y Autenticación (Cambiar en producción)
JWT_SECRET=tu_jwt_secret_seguro_aqui
JWT_EXPIRES_IN=24h
# Generar una clave privada de exactamente 32 bytes UTF-8; ver docs/modelo-datos/actualizar-equipo.md.
# No cambiarla si la base ya contiene datos cifrados con una clave existente.
AES_SECRET_KEY=

# Integraciones de Microservicios
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173

# Supabase Storage (Almacenamiento de documentos médicos)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key
SUPABASE_BUCKET=medical-documents
