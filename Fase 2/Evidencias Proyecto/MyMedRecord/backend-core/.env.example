JWT_EXPIRES_IN=24h
AES_SECRET_KEY=clave_aes_de_32_caracteres_min

# Integraciones de Microservicios
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173
